{
  "expo": {
    "name": "MathiKids",
    "slug": "mathikids",
    "icon": "./assets/icon.png",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FFF8E7"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.imanbidarigh.mathikids"
    },
    "android": {
      "package": "com.imanbidarigh.mathikids",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFD43B"
      }
    },
    "plugins": ["expo-audio"],
    "extra": {
      "eas": {
        "projectId": "9efc714b-769a-4dc9-ba45-e266b8ce6aae"
      }
    },
    "owner": "imanbidarigh"
  }
}